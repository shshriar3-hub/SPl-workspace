#include<stdio.h>
int main()
{   
   int n ,m;
   printf("Enter number of rows: ");//n represent number lines.But have to use \n= new line for new line in outer loop.
   scanf("%d",&n);
   printf("Enter number of colums: ");//m represent number of colums. 
   scanf("%d",&m);
   for(int i=1;i<=n;i++){
    for(int i=1;i<=m;i++)
    {
        printf("*");
    }
    printf("\n");
   }
    return 0;
}
